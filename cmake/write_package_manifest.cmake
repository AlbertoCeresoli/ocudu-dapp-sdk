foreach(argument IN ITEMS OUTPUT SBOM ARTIFACT PACKAGE_ID GLOBAL_NAME VENDOR VERSION DAPP_CLASS INTERFACE_ID
    PACKAGE_PLACEMENT INTERFACE_PLACEMENT BACKEND)
  if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
    message(FATAL_ERROR "Missing package-manifest argument: ${argument}")
  endif()
endforeach()

if(NOT EXISTS "${ARTIFACT}")
  message(FATAL_ERROR "Package artifact does not exist: ${ARTIFACT}")
endif()
execute_process(COMMAND /bin/chmod 0555 "${ARTIFACT}" RESULT_VARIABLE artifact_chmod_result)
if(NOT artifact_chmod_result EQUAL 0)
  message(FATAL_ERROR "Unable to make the package artifact read-only and executable")
endif()
if(PACKAGE_PLACEMENT STREQUAL "in_process")
  set(package_placements "\"in_process\"")
elseif(PACKAGE_PLACEMENT STREQUAL "out_of_process")
  set(package_placements "\"out_of_process\"")
else()
  message(FATAL_ERROR "Unsupported package placement: ${PACKAGE_PLACEMENT}")
endif()
function(interface_placements_for value output)
  if(value STREQUAL "in_process")
    set(result "\"in_process\"")
  elseif(value STREQUAL "out_of_process")
    set(result "\"out_of_process\"")
  elseif(value STREQUAL "both")
    set(result "\"in_process\", \"out_of_process\"")
  else()
    message(FATAL_ERROR "Unsupported interface placement: ${value}")
  endif()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

interface_placements_for("${INTERFACE_PLACEMENT}" interface_placements)
if(NOT DAPP_CLASS MATCHES "^[ABC]$")
  message(FATAL_ERROR "Unsupported dApp class: ${DAPP_CLASS}")
endif()
if(NOT BACKEND MATCHES "^(cpu|cuda)$")
  message(FATAL_ERROR "Unsupported package backend: ${BACKEND}")
endif()
if(NOT DEFINED CAPABILITIES OR "${CAPABILITIES}" STREQUAL "")
  set(CAPABILITIES 0)
endif()
if(NOT DEFINED BINDING OR "${BINDING}" STREQUAL "")
  set(BINDING required)
endif()
if(NOT DEFINED INTERFACE_COUNT OR "${INTERFACE_COUNT}" STREQUAL "")
  set(INTERFACE_COUNT 1)
endif()
if(NOT INTERFACE_COUNT MATCHES "^[1-9][0-9]*$" OR INTERFACE_COUNT GREATER 16)
  message(FATAL_ERROR "INTERFACE_COUNT must be between 1 and 16")
endif()

function(escape_json input output)
  string(REPLACE "\\" "\\\\" escaped "${input}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  set(${output} "${escaped}" PARENT_SCOPE)
endfunction()

file(SHA256 "${ARTIFACT}" digest)
file(SHA1 "${ARTIFACT}" artifact_sha1)
string(SHA1 package_verification_code "${artifact_sha1}")
file(TIMESTAMP "${ARTIFACT}" artifact_timestamp "%Y-%m-%dT%H:%M:%SZ" UTC)
get_filename_component(artifact_name "${ARTIFACT}" NAME)
get_filename_component(sbom_name "${SBOM}" NAME)
escape_json("${artifact_name}" artifact_name)
escape_json("${GLOBAL_NAME}" global_name)
escape_json("${VENDOR}" vendor_name)
escape_json("${VERSION}" version)

set(sbom_document "{\n")
string(APPEND sbom_document "  \"spdxVersion\": \"SPDX-2.3\",\n")
string(APPEND sbom_document "  \"dataLicense\": \"CC0-1.0\",\n")
string(APPEND sbom_document "  \"SPDXID\": \"SPDXRef-DOCUMENT\",\n")
string(APPEND sbom_document "  \"name\": \"${global_name}-${version}-sbom\",\n")
string(APPEND sbom_document "  \"documentNamespace\": \"https://ocudu.org/spdx/dapp/${PACKAGE_ID}/${digest}\",\n")
string(APPEND sbom_document "  \"creationInfo\": {\n")
string(APPEND sbom_document "    \"created\": \"${artifact_timestamp}\",\n")
string(APPEND sbom_document "    \"creators\": [\"Tool: OCUDU dApp SDK package generator\"]\n")
string(APPEND sbom_document "  },\n")
string(APPEND sbom_document "  \"packages\": [{\n")
string(APPEND sbom_document "    \"SPDXID\": \"SPDXRef-Package\",\n")
string(APPEND sbom_document "    \"name\": \"${global_name}\",\n")
string(APPEND sbom_document "    \"versionInfo\": \"${version}\",\n")
string(APPEND sbom_document "    \"supplier\": \"Organization: ${vendor_name}\",\n")
string(APPEND sbom_document "    \"downloadLocation\": \"NOASSERTION\",\n")
string(APPEND sbom_document "    \"filesAnalyzed\": true,\n")
string(APPEND sbom_document "    \"packageVerificationCode\": {\"packageVerificationCodeValue\": \"${package_verification_code}\"},\n")
string(APPEND sbom_document "    \"licenseConcluded\": \"BSD-3-Clause-Clear\",\n")
string(APPEND sbom_document "    \"licenseDeclared\": \"BSD-3-Clause-Clear\",\n")
string(APPEND sbom_document "    \"copyrightText\": \"Copyright (C) 2026 DeepSig Inc.\",\n")
string(APPEND sbom_document "    \"hasFiles\": [\"SPDXRef-Artifact\"]\n")
string(APPEND sbom_document "  }],\n")
string(APPEND sbom_document "  \"files\": [{\n")
string(APPEND sbom_document "    \"SPDXID\": \"SPDXRef-Artifact\",\n")
string(APPEND sbom_document "    \"fileName\": \"./${artifact_name}\",\n")
string(APPEND sbom_document "    \"checksums\": [\n")
string(APPEND sbom_document "      {\"algorithm\": \"SHA1\", \"checksumValue\": \"${artifact_sha1}\"},\n")
string(APPEND sbom_document "      {\"algorithm\": \"SHA256\", \"checksumValue\": \"${digest}\"}\n")
string(APPEND sbom_document "    ],\n")
string(APPEND sbom_document "    \"licenseConcluded\": \"BSD-3-Clause-Clear\",\n")
string(APPEND sbom_document "    \"licenseInfoInFiles\": [\"BSD-3-Clause-Clear\"],\n")
string(APPEND sbom_document "    \"copyrightText\": \"Copyright (C) 2026 DeepSig Inc.\"\n")
string(APPEND sbom_document "  }],\n")
string(APPEND sbom_document "  \"relationships\": [{\n")
string(APPEND sbom_document "    \"spdxElementId\": \"SPDXRef-DOCUMENT\",\n")
string(APPEND sbom_document "    \"relationshipType\": \"DESCRIBES\",\n")
string(APPEND sbom_document "    \"relatedSpdxElement\": \"SPDXRef-Package\"\n")
string(APPEND sbom_document "  }]\n")
string(APPEND sbom_document "}\n")

file(REMOVE "${SBOM}.tmp")
file(WRITE "${SBOM}.tmp" "${sbom_document}")
execute_process(COMMAND /bin/chmod 0444 "${SBOM}.tmp" RESULT_VARIABLE sbom_chmod_result)
if(NOT sbom_chmod_result EQUAL 0)
  file(REMOVE "${SBOM}.tmp")
  message(FATAL_ERROR "Unable to make the package SBOM read-only")
endif()
file(RENAME "${SBOM}.tmp" "${SBOM}")
file(SHA256 "${SBOM}" sbom_digest)

set(document "{\n")
string(APPEND document "  \"schema_version\": 1,\n")
string(APPEND document "  \"package_id\": \"${PACKAGE_ID}\",\n")
string(APPEND document "  \"global_name\": \"${global_name}\",\n")
string(APPEND document "  \"vendor\": \"${vendor_name}\",\n")
string(APPEND document "  \"version\": \"${version}\",\n")
string(APPEND document "  \"artifact\": \"${artifact_name}\",\n")
string(APPEND document "  \"sha256\": \"${digest}\",\n")
string(APPEND document "  \"placements\": [${package_placements}],\n")
string(APPEND document "  \"backends\": [\"${BACKEND}\"],\n")
string(APPEND document "  \"interfaces\": [\n")
foreach(index RANGE 1 ${INTERFACE_COUNT})
  if(index EQUAL 1)
    set(current_interface_id "${INTERFACE_ID}")
    set(current_class "${DAPP_CLASS}")
    set(current_placement "${INTERFACE_PLACEMENT}")
    set(current_capabilities "${CAPABILITIES}")
    set(current_binding "${BINDING}")
  else()
    foreach(field IN ITEMS INTERFACE_ID DAPP_CLASS INTERFACE_PLACEMENT)
      if(NOT DEFINED ${field}_${index} OR "${${field}_${index}}" STREQUAL "")
        message(FATAL_ERROR "Missing package-manifest argument: ${field}_${index}")
      endif()
    endforeach()
    set(current_interface_id "${INTERFACE_ID_${index}}")
    set(current_class "${DAPP_CLASS_${index}}")
    set(current_placement "${INTERFACE_PLACEMENT_${index}}")
    if(DEFINED CAPABILITIES_${index} AND NOT "${CAPABILITIES_${index}}" STREQUAL "")
      set(current_capabilities "${CAPABILITIES_${index}}")
    else()
      set(current_capabilities 0)
    endif()
    if(DEFINED BINDING_${index} AND NOT "${BINDING_${index}}" STREQUAL "")
      set(current_binding "${BINDING_${index}}")
    else()
      set(current_binding required)
    endif()
  endif()
  if(NOT current_class MATCHES "^[ABC]$")
    message(FATAL_ERROR "Unsupported dApp class at interface ${index}: ${current_class}")
  endif()
  if(NOT current_binding MATCHES "^(required|optional)$")
    message(FATAL_ERROR "Unsupported binding policy at interface ${index}: ${current_binding}")
  endif()
  interface_placements_for("${current_placement}" current_placements)
  math(EXPR current_interface_id_decimal "${current_interface_id}")
  math(EXPR current_capabilities_decimal "${current_capabilities}")
  string(APPEND document "    {\n")
  string(APPEND document "      \"interface_id\": ${current_interface_id_decimal},\n")
  string(APPEND document "      \"major\": 1,\n")
  string(APPEND document "      \"minor\": 0,\n")
  string(APPEND document "      \"class\": \"${current_class}\",\n")
  string(APPEND document "      \"placements\": [${current_placements}],\n")
  string(APPEND document "      \"threading\": \"per_worker\",\n")
  string(APPEND document "      \"binding\": \"${current_binding}\",\n")
  if(current_class STREQUAL "A")
    if(BACKEND STREQUAL "cuda")
      set(max_layers 2)
      set(profile_flags 2)
    else()
      set(max_layers 1)
      set(profile_flags 0)
    endif()
    string(APPEND document "      \"capabilities\": ${current_capabilities_decimal},\n")
    string(APPEND document "      \"pusch_profile\": {\"max_prb\": 275, \"max_rx_ports\": 64, ")
    string(APPEND document "\"max_layers\": ${max_layers}, \"modulation_mask\": 15, \"dmrs_type_mask\": 3, \"flags\": ${profile_flags}}\n")
  else()
    string(APPEND document "      \"capabilities\": ${current_capabilities_decimal}\n")
  endif()
  if(index LESS INTERFACE_COUNT)
    string(APPEND document "    },\n")
  else()
    string(APPEND document "    }\n")
  endif()
endforeach()
string(APPEND document "  ],\n")
string(APPEND document "  \"provenance\": {\n")
string(APPEND document "    \"sbom\": \"${sbom_name}\",\n")
string(APPEND document "    \"format\": \"spdx-2.3-json\",\n")
string(APPEND document "    \"sha256\": \"${sbom_digest}\"\n")
string(APPEND document "  }\n")
string(APPEND document "}\n")

file(REMOVE "${OUTPUT}.tmp")
file(WRITE "${OUTPUT}.tmp" "${document}")
execute_process(COMMAND /bin/chmod 0444 "${OUTPUT}.tmp" RESULT_VARIABLE chmod_result)
if(NOT chmod_result EQUAL 0)
  file(REMOVE "${OUTPUT}.tmp")
  message(FATAL_ERROR "Unable to make the package manifest read-only")
endif()
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
